# Terraform. Keep each stack's .terraform.lock.hcl: it pins the providers.
# A reusable module's is ignored by Terraform, so it isn't kept.
.terraform/
terraform/modules/**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Credentials. The App's private key and any token file never belong here.
*.pem
.env
.env.*

.DS_Store
